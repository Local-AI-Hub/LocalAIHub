{
  "name": "local-ai-hub",
  "version": "0.4.0",
  "description": "Windows desktop manager for local AI tools",
  "author": "Local AI Hub",
  "private": true,
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Local-AI-Hub/LocalAIHub.git"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:ui": "vite build",
    "build": "npm run build:ui && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.2.0",
    "python-shell": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.24.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.localaihub.desktop",
    "productName": "Local AI Hub",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/helpers/**/*",
      "!electron/config/tools-manifest.json",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Local-AI-Hub",
        "repo": "LocalAIHub",
        "releaseType": "release"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "LocalAIHub-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "filter": [
          "**/*"
        ],
        "from": "electron/helpers",
        "to": "helpers"
      }
    ]
  }
}

{
  "name": "local-ai-hub",
  "version": "0.44.0",
  "description": "Windows desktop manager for local AI tools",
  "author": "Local AI Hub",
  "private": true,
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Local-AI-Hub/LocalAIHub.git"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:ui": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:ui": "vite build",
    "build": "npm run build:ui && electron-builder",
    "sign:manifest": "node scripts/sign-tools-manifest.js",
    "verify:manifest": "node scripts/sign-tools-manifest.js --verify",
    "verify:launch-modes": "node scripts/verify-launch-modes.js",
    "verify:asset-libraries": "node scripts/verify-asset-library-manager.js",
    "preview": "vite preview",
    "remediate:lifecycle": "node scripts/remediate-local-ai-hub.js",
    "verify:audio-pipeline": "node scripts/verify-audio-pipeline.js",
    "verify:wan-launch": "node scripts/verify-wan-launch-readiness.js",
    "verify:triposr-launch": "node scripts/verify-triposr-launch-readiness.js",
    "verify:media-composition": "node scripts/verify-pipeline-media-composition.js",
    "verify:media-regressions": "node scripts/verify-pipeline-regression-coverage.js",
    "verify:model-download-plans": "node scripts/verify-model-download-plans.js",
    "verify:provider-credential-security": "node scripts/verify-provider-credential-security.js",
    "verify:aider-ollama-lifecycle": "node scripts/verify-aider-ollama-lifecycle.js",
    "verify:statistics-index": "node scripts/verify-statistics-index.js",
    "verify:wizard-live": "node scripts/verify-pipeline-wizard-live-validation.js --live-provider-validation"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "archiver": "^7.0.1",
    "electron-updater": "^6.3.9",
    "extract-zip": "^2.0.1",
    "ffmpeg-static": "^5.3.0",
    "fs-extra": "^11.2.0",
    "keytar": "^7.9.0",
    "python-shell": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.24.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.localaihub.desktop",
    "productName": "Local AI Hub",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/**/*",
      "!node_modules/7zip-bin/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Local-AI-Hub",
        "repo": "LocalAIHub",
        "releaseType": "release"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ],
      "artifactName": "LocalAIHub-Setup-${version}.${ext}",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "include": "build/installer.nsh",
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": false
    },
    "icon": "icon.ico",
    "extraResources": [
      {
        "filter": [
          "**/*.py"
        ],
        "from": "electron/helpers",
        "to": "helpers"
      },
      {
        "from": "icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "node_modules/7zip-bin/win/x64/7za.exe",
        "to": "bin/7za.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      }
    ]
  }
}
